{
  "name": "spec-craft",
  "productName": "SpecCraft",
  "version": "0.1.0",
  "description": "Offline desktop app for Spec-Driven Development (SDD) with AI coding agents",
  "main": "./out/main/index.js",
  "author": "Vilmar Bispo Filho",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "icon": "electron scripts/render-icon.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-text": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "i18next": "^26.6.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-winstaller@5.4.0": true
  }
}
